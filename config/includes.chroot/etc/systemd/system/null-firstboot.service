[Unit]
Description=Null Server first boot (host keys, machine-id, disk growth)
ConditionPathExists=!/var/lib/null-server/firstboot-done
ConditionKernelCommandLine=!boot=live
DefaultDependencies=no
After=local-fs.target systemd-remount-fs.service
Before=ssh.service network-pre.target sysinit.target
Wants=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/null-firstboot
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
